---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

const nav = [
  { label: 'Get Started', links: [
    { href: '/', text: 'Overview' },
    { href: '/contribute', text: 'Ways to Contribute' },
    { href: '/translations', text: 'Translate & Review' },
    { href: '/workflow', text: 'Dev Workflow' },
  ]},
  { label: 'Architecture', links: [
    { href: '/architecture', text: 'System Overview' },
    { href: '/architecture#tag-dsl', text: 'Tag DSL / GM Protocol' },
    { href: '/architecture#transport', text: 'Transport Layer' },
    { href: '/architecture#ai-gm', text: 'AI GM' },
    { href: '/architecture#voice', text: 'Voice Stack' },
  ]},
  { label: 'World & Design', links: [
    { href: '/art-bible', text: 'Art Bible' },
    { href: '/art-bible#call-for-art', text: 'Call for Art' },
    { href: '/no-ai-art', text: 'No AI Art Policy' },
    { href: '/design-tokens', text: 'Design Tokens' },
  ]},
  { label: 'License & Community', links: [
    { href: '/contribute#community-care', text: 'Help Wanted: Community Lead' },
    { href: '/community-content', text: 'Community Content Program' },
    { href: '/succession', text: 'Succession & Continuity' },
  ]},
  { label: 'Project', links: [
    { href: '/roadmap', text: 'Roadmap' },
    { href: '/roadmap#changelog', text: 'Changelog' },
    { href: '/press-kit', text: 'Press Kit' },
    { href: 'https://github.com/Chronophage-net/fates-edge-dev/discussions', text: 'Discussions ↗' },
    { href: 'https://discord.gg/etmb7DYbj', text: 'Discord ↗' },
    { href: 'https://github.com/Chronophage-net/fates-edge-dev/wiki', text: 'Wiki ↗' },
    { href: 'https://github.com/Chronophage-net', text: 'All Repos ↗' },
  ]},
];
---
<BaseLayout title={title} description={description}>
  <div class="portal-shell" style="padding-top: 2rem;">
    <aside class="side-nav">
      {nav.map((group) => (
        <>
          <h4>{group.label}</h4>
          {group.links.map((l) => <a href={l.href}>{l.text}</a>)}
        </>
      ))}
    </aside>
    <div class="docs-body">
      <slot />
      <Giscus />
    </div>
  </div>
</BaseLayout>
