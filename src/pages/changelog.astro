---
import DocsLayout from '../layouts/DocsLayout.astro';

// Pulls recently-merged PRs from the public repos at build time via the
// GitHub REST API (unauthenticated — fine for a handful of requests per
// build, well under the 60/hr rate limit). Falls back to an empty list
// per-repo if a fetch fails (e.g. local dev with no network, or the repo
// is momentarily rate-limited) rather than failing the whole build.

const REPOS = [
  { repo: 'Chronophage-net/fates-edge-dev', label: 'Dev Portal' },
  { repo: 'Chronophage-net/fates-edge-apps', label: 'Apps' },
  { repo: 'Chronophage-net/fates-edge-ai-gm-bot', label: 'AI GM Bot' },
];

async function fetchMergedPRs({ repo, label }) {
  try {
    const url = `https://api.github.com/search/issues?q=repo:${repo}+is:pr+is:merged&sort=updated&order=desc&per_page=10`;
    const res = await fetch(url, {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (!res.ok) return [];
    const data = await res.json();
    return (data.items ?? []).map((item) => ({
      repo,
      label,
      title: item.title,
      number: item.number,
      url: item.html_url,
      mergedAt: item.closed_at,
      author: item.user?.login,
    }));
  } catch {
    return [];
  }
}

const results = await Promise.all(REPOS.map(fetchMergedPRs));
const entries = results
  .flat()
  .filter((e) => e.mergedAt)
  .sort((a, b) => new Date(b.mergedAt) - new Date(a.mergedAt))
  .slice(0, 30);

function fmtDate(iso) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<DocsLayout title="Changelog" description="Recently merged pull requests across the Fate's Edge repos.">
  <h1>Changelog</h1>
  <p>A rolling feed of what's actually landed, pulled straight from merged pull requests across the public repos. For direction rather than done-ness, see the <a href="/roadmap">Roadmap</a>; for the running commentary on why something was built a certain way, see the <a href="https://blog.fates-edge.com">dev blog</a>.</p>

  {entries.length === 0 && (
    <div class="callout">
      <strong>Couldn't reach GitHub at build time.</strong> This page pulls live data during the site build — try a rebuild, or see each repo's Pull Requests tab directly in the meantime.
    </div>
  )}

  <ul class="changelog-list">
    {entries.map((e) => (
      <li>
        <span class="changelog-date">{fmtDate(e.mergedAt)}</span>
        <span class="changelog-repo">{e.label}</span>
        <a href={e.url} target="_blank" rel="noopener">{e.title}</a>
        <span class="changelog-meta">#{e.number}{e.author ? ` · ${e.author}` : ''}</span>
      </li>
    ))}
  </ul>
</DocsLayout>

<style>
  .changelog-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .changelog-list li {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.6rem;
  }
  .changelog-date {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--text3);
    min-width: 6.5rem;
  }
  .changelog-repo {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: rgba(201,168,76,0.1);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }
  .changelog-list a {
    flex: 1 1 auto;
  }
  .changelog-meta {
    font-size: 0.8rem;
    color: var(--text3);
  }
</style>
