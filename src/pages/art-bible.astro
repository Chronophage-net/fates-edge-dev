---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

const [bible] = await getCollection('art', ({ id }) => id === 'art-bible.md');
const { Content } = await bible.render();
---
<DocsLayout title="Art Bible" description={bible.data.description}>
  <div class="callout">
    <strong>Want to contribute art?</strong> See <a href="/call-for-art">Call for Art</a> for how to submit, the fan-art policy, and licensing.
  </div>
  <h1>{bible.data.title}</h1>
  <Content />
</DocsLayout>
