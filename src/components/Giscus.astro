---
// Inline GitHub Discussions comments via giscus (https://giscus.app).
// One thread per page path (data-mapping="pathname"), lazy-loaded so it
// doesn't cost anything until a visitor scrolls near it.
---
<hr style="border-color:var(--border); margin:3rem 0 2rem;" />
<h2 style="color:var(--gold); font-size:1.1rem; margin-bottom:1rem;">Discuss this page</h2>
<script
  src="https://giscus.app/client.js"
  data-repo="Chronophage-net/fates-edge-dev"
  data-repo-id="R_kgDOUDzulw"
  data-category="Comments"
  data-category-id="DIC_kwDOUDzul84DEPW6"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="preferred_color_scheme"
  data-lang="en"
  data-loading="lazy"
  crossorigin="anonymous"
  async
></script>
